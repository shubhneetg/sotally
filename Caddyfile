# Main domain
{$DOMAIN:sotally.com} {
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy api:4000
    }
    handle /webhooks/* {
        reverse_proxy api:4000
    }
    handle {
        reverse_proxy web:3000
    }
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        -Server
    }
    encode gzip
}

# V2: Creator subdomains — *.sotally.com
# Next.js middleware handles rewriting subdomain to storefront/app routes
*.{$DOMAIN:sotally.com} {
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy api:4000
    }
    handle {
        reverse_proxy web:3000
    }
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        -Server
    }
    encode gzip
    tls {
        on_demand
    }
}

# Legacy: sotools.com subdomains (V1 compat)
*.sotools.com, sotools.com {
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy api:4000
    }
    handle {
        reverse_proxy web:3000
    }
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        -Server
    }
    encode gzip
    tls {
        on_demand
    }
}
