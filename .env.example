# ─── API ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://sotally:sotally@localhost:5432/sotally

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── LLM Provider (V2 App Generation) ────────────────────────────────────────
# Set GENERATION_PROVIDER to: anthropic | openai | moonshot | openai-compatible
# Or leave blank — the system auto-detects based on which API key is set.
# Priority: Anthropic > Moonshot > OpenAI > OpenAI-compatible
GENERATION_PROVIDER=

# Set a specific model, or leave blank for provider defaults:
# - Anthropic: claude-sonnet-4-20250514
# - OpenAI: gpt-4o
# - Moonshot: moonshot-v1-128k
GENERATION_MODEL=

# LLM API Keys — set at least ONE for app generation to work
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MOONSHOT_API_KEY=

# Generic OpenAI-compatible provider (DeepSeek, Groq, Together, Ollama, etc.)
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com/v1

# ─── Object Storage (MinIO / S3) ─────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=sotally
S3_SECRET_KEY=sotally-secret-key
S3_BUCKET=sotally-apps
# S3_PUBLIC_URL=https://cdn.sotally.com  # set in production for CDN

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=generate-a-random-32-char-string
NEXTAUTH_URL=http://localhost:3000

# ─── Encryption ───────────────────────────────────────────────────────────────
API_KEY_ENCRYPTION_KEY=generate-a-random-64-char-hex-string

# ─── OAuth Providers ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
